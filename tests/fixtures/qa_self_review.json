        {"author": {"name": "starter", "displayName": "Star Ter"}, "created": "2026-10-01T09:00:00.000+0200", "items": [{"field": "status", "from": "1", "fromString": "Open", "to": "3", "toString": "In Progress"}]},
        {"author": {"name": "rev", "displayName": "Rev Iewer"}, "created": "2026-10-02T09:00:00.000+0200", "items": [{"field": "status", "from": "3", "fromString": "In Progress", "to": "10", "toString": "QA"}, {"field": "assignee", "fromString": "Rev Iewer", "toString": null}]}
